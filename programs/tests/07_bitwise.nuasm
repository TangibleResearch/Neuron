// Bitwise test.
//
// 12 = 1100
// 10 = 1010
//
// AND = 8
// OR  = 14
// XOR = 6

MOVI R1, 12
MOVI R2, 10

AND R3, R1, R2
MOVI R4, 8
CMP R3, R4
JNZ fail

OR R3, R1, R2
MOVI R4, 14
CMP R3, R4
JNZ fail

XOR R3, R1, R2
MOVI R4, 6
CMP R3, R4
JNZ fail

// 3 << 2 = 12

MOVI R1, 3
MOVI R2, 2
SHL R3, R1, R2

MOVI R4, 12
CMP R3, R4
JNZ fail

// 12 >> 2 = 3

SHR R3, R3, R2

MOVI R4, 3
CMP R3, R4
JNZ fail

pass:
MOVI R1, 80
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 10
OUT R1
HALT

fail:
MOVI R1, 70
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 73
OUT R1
MOVI R1, 76
OUT R1
MOVI R1, 10
OUT R1
HALT