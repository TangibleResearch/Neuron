// Sustained scalar execution test.
//
// Repeat 10,000 times:
//
// R4 = R4 + 3
// R4 = R4 * 2
// R4 = R4 XOR 7
//
// Main purpose isn't the final number.
// It's sustained fetch/decode/issue/ALU/branch execution.

MOVI R1, 0
MOVI R2, 1
MOVI R3, 10000

MOVI R4, 1
MOVI R5, 3
MOVI R6, 2
MOVI R7, 7

loop:
ADD R4, R4, R5
MUL R4, R4, R6
XOR R4, R4, R7

ADD R1, R1, R2

CMP R1, R3
JNZ loop

// Make sure exactly 10,000 iterations happened.

CMP R1, R3
JNZ fail

pass:
MOVI R1, 80
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 10
OUT R1
HALT

fail:
MOVI R1, 70
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 73
OUT R1
MOVI R1, 76
OUT R1
MOVI R1, 10
OUT R1
HALT