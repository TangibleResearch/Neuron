// ============================================================
// Neuron 4 -> 4 -> 2 Neural Network
//
// Inputs:
// x0 = 1
// x1 = 2
// x2 = 3
// x3 = 4
//
// Hidden Layer:
//
// H0 weights = [ 1,  1, 1,  1]
// H0 = 1 + 2 + 3 + 4 = 10
// ReLU(10) = 10
//
// H1 weights = [ 1, -1, 1, -1]
// H1 = 1 - 2 + 3 - 4 = -2
// ReLU(-2) = 0
//
// H2 weights = [ 2,  1, 0, -1]
// H2 = 2 + 2 + 0 - 4 = 0
// ReLU(0) = 0
//
// H3 weights = [-1,  2, 1,  1]
// H3 = -1 + 4 + 3 + 4 = 10
// ReLU(10) = 10
//
// Output Layer:
//
// Y0 weights = [1, 2, 3, 1]
// Y0 = 10*1 + 0*2 + 0*3 + 10*1
//    = 20
//
// Y1 weights = [2, 1, 1, 2]
// Y1 = 10*2 + 0*1 + 0*1 + 10*2
//    = 40
//
// Expected:
// Y0 = 20
// Y1 = 40
// ============================================================


// ============================================================
// INPUT REGISTERS
//
// R0 = x0
// R1 = x1
// R2 = x2
// R3 = x3
// ============================================================

MOVI R0, 1
MOVI R1, 2
MOVI R2, 3
MOVI R3, 4


// ============================================================
// HIDDEN NEURON 0
//
// weights = [1, 1, 1, 1]
// H0 = 10
//
// R4 = H0
// ============================================================

MOVI R8, 1
MOVI R9, 1
MOVI R10, 1
MOVI R11, 1

MACCLR

MAC R0, R8
MAC R1, R9
MAC R2, R10
MAC R3, R11

MACREAD R4

RELU R4


// ============================================================
// HIDDEN NEURON 1
//
// weights = [1, -1, 1, -1]
//
// 255 interpreted as INT8 = -1
//
// H1 = -2
// ReLU(-2) = 0
//
// R5 = H1
// ============================================================

MOVI R8, 1
MOVI R9, 255
MOVI R10, 1
MOVI R11, 255

MACCLR

MAC R0, R8
MAC R1, R9
MAC R2, R10
MAC R3, R11

MACREAD R5

RELU R5


// ============================================================
// HIDDEN NEURON 2
//
// weights = [2, 1, 0, -1]
//
// H2 = 0
// ReLU(0) = 0
//
// R6 = H2
// ============================================================

MOVI R8, 2
MOVI R9, 1
MOVI R10, 0
MOVI R11, 255

MACCLR

MAC R0, R8
MAC R1, R9
MAC R2, R10
MAC R3, R11

MACREAD R6

RELU R6


// ============================================================
// HIDDEN NEURON 3
//
// weights = [-1, 2, 1, 1]
//
// H3 = 10
// ReLU(10) = 10
//
// R7 = H3
// ============================================================

MOVI R8, 255
MOVI R9, 2
MOVI R10, 1
MOVI R11, 1

MACCLR

MAC R0, R8
MAC R1, R9
MAC R2, R10
MAC R3, R11

MACREAD R7

RELU R7


// ============================================================
// OUTPUT NEURON 0
//
// weights = [1, 2, 3, 1]
//
// Y0 =
// H0*1 +
// H1*2 +
// H2*3 +
// H3*1
//
// = 10 + 0 + 0 + 10
// = 20
//
// R12 = Y0
// ============================================================

MOVI R8, 1
MOVI R9, 2
MOVI R10, 3
MOVI R11, 1

MACCLR

MAC R4, R8
MAC R5, R9
MAC R6, R10
MAC R7, R11

MACREAD R12


// ============================================================
// OUTPUT NEURON 1
//
// weights = [2, 1, 1, 2]
//
// Y1 =
// H0*2 +
// H1*1 +
// H2*1 +
// H3*2
//
// = 20 + 0 + 0 + 20
// = 40
//
// R13 = Y1
// ============================================================

MOVI R8, 2
MOVI R9, 1
MOVI R10, 1
MOVI R11, 2

MACCLR

MAC R4, R8
MAC R5, R9
MAC R6, R10
MAC R7, R11

MACREAD R13


// ============================================================
// VERIFY Y0
// ============================================================

MOVI R14, 20

CMP R12, R14

JNZ fail


// ============================================================
// VERIFY Y1
// ============================================================

MOVI R14, 40

CMP R13, R14

JNZ fail


// ============================================================
// PASS
// ============================================================

MOVI R15, 80
OUT R15

MOVI R15, 65
OUT R15

MOVI R15, 83
OUT R15

MOVI R15, 83
OUT R15

MOVI R15, 10
OUT R15

HALT


// ============================================================
// FAIL
// ============================================================

fail:

MOVI R15, 70
OUT R15

MOVI R15, 65
OUT R15

MOVI R15, 73
OUT R15

MOVI R15, 76
OUT R15

MOVI R15, 10
OUT R15

HALT