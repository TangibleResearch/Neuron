// Arithmetic chain:
//
// 10 + 5 = 15
// 15 * 4 = 60
// 60 - 12 = 48
// 48 / 6 = 8
// 8 % 3 = 2

MOVI R1, 10
MOVI R2, 5
ADD R3, R1, R2

MOVI R4, 4
MUL R3, R3, R4

MOVI R4, 12
SUB R3, R3, R4

MOVI R4, 6
DIV R3, R3, R4

MOVI R4, 3
MOD R3, R3, R4

MOVI R5, 2
CMP R3, R5
JNZ fail

pass:
MOVI R1, 80
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 10
OUT R1
HALT

fail:
MOVI R1, 70
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 73
OUT R1
MOVI R1, 76
OUT R1
MOVI R1, 10
OUT R1
HALT