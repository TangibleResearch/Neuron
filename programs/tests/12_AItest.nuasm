// Load M0 with a nonzero 4x4 matrix.
MSET M0, 0, 0, 1
MSET M0, 0, 1, 2
MSET M0, 0, 2, 3
MSET M0, 0, 3, 4
MSET M0, 1, 0, 5
MSET M0, 1, 1, 6
MSET M0, 1, 2, 7
MSET M0, 1, 3, 8
MSET M0, 2, 0, 9
MSET M0, 2, 1, 10
MSET M0, 2, 2, 11
MSET M0, 2, 3, 12
MSET M0, 3, 0, 13
MSET M0, 3, 1, 14
MSET M0, 3, 2, 15
MSET M0, 3, 3, 16

// Load M1 with the identity matrix.
MSET M1, 0, 0, 1
MSET M1, 0, 1, 0
MSET M1, 0, 2, 0
MSET M1, 0, 3, 0
MSET M1, 1, 0, 0
MSET M1, 1, 1, 1
MSET M1, 1, 2, 0
MSET M1, 1, 3, 0
MSET M1, 2, 0, 0
MSET M1, 2, 1, 0
MSET M1, 2, 2, 1
MSET M1, 2, 3, 0
MSET M1, 3, 0, 0
MSET M1, 3, 1, 0
MSET M1, 3, 2, 0
MSET M1, 3, 3, 1

// M2 should now equal M0.
MMUL M2, M0, M1
HALT
