// Perform 1000 STORE + LOAD round trips.

MOVI R1, 512
MOVI R2, 123456

MOVI R3, 0
MOVI R4, 1
MOVI R5, 1000

loop:
STORE R1, R2
LOAD R6, R1

CMP R6, R2
JNZ fail

ADD R3, R3, R4

CMP R3, R5
JNZ loop

pass:
MOVI R1, 80
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 10
OUT R1
HALT

fail:
MOVI R1, 70
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 73
OUT R1
MOVI R1, 76
OUT R1
MOVI R1, 10
OUT R1
HALT