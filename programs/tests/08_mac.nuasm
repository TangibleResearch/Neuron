// MAC accelerator test.
//
// ACC = 3*4
//     + 5*6
//     + 2*7
//
// = 12 + 30 + 14
// = 56

MACCLR

MOVI R1, 3
MOVI R2, 4
MAC R1, R2

MOVI R1, 5
MOVI R2, 6
MAC R1, R2

MOVI R1, 2
MOVI R2, 7
MAC R1, R2

MACREAD R3

MOVI R4, 56
CMP R3, R4
JNZ fail

pass:
MOVI R1, 80
OUT R1
MOVI R1, 65
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 83
OUT R1
MOVI R1, 10
OUT R1
HALT

